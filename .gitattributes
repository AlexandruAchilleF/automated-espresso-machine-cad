# AutoCAD Native CAD Files & Templates (Binary)
*.dwg -text
*.dwt -text
*.dxf -text

# Neutral 3D CAD & Geometry Exchange Formats
*.step -text
*.stp -text
*.iges -text
*.igs -text
*.sat -text

# 3D Printing, Mesh & Visualization Formats
*.stl -text
*.obj -text
